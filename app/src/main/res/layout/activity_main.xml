<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="iOS 17 / ColorOS 16 风格壁纸延展 · 自然过渡 · 支持保存到相册"
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <!-- 原图尺寸信息 + 输出高度设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="原图尺寸: -"
                android:textSize="14sp"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="输出高度(px):"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

                <EditText
                    android:id="@+id/etTargetHeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:inputType="number"
                    android:hint="空=自动"
                    android:textSize="14sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbTopOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="仅顶部延展（底部保留原图，更接近 iOS 17）"
                android:checked="true"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 原图预览（PhotoView 可缩放） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="原图（可双指缩放）"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <com.github.chrisbanes.photoview.PhotoView
            android:id="@+id/imgOriginal"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="fitCenter"
            android:background="@color/card"
            android:contentDescription="原图预览" />

        <!-- ★ 参数调节（已补全所有控件） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card"
            android:padding="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <!-- 模糊半径 -->
            <TextView
                android:id="@+id/tvBlur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="模糊半径: 20"
                android:textSize="14sp"
                android:textColor="@color/text_primary" />
            <SeekBar
                android:id="@+id/seekBlur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60"
                android:progress="20" />

            <!-- 延展比例 -->
            <TextView
                android:id="@+id/tvExtend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="延展比例: 37%"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />
            <SeekBar
                android:id="@+id/seekExtend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60"
                android:progress="37" />

            <!-- 羽化宽度 -->
            <TextView
                android:id="@+id/tvFeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="羽化宽度: 150"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />
            <SeekBar
                android:id="@+id/seekFeather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="300"
                android:progress="150" />

            <!-- ★ 饱和度 -->
            <TextView
                android:id="@+id/tvSaturation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="饱和度: 1.1x"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />
            <SeekBar
                android:id="@+id/seekSaturation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="150"
                android:progress="60" />

            <!-- ★ 亮度 -->
            <TextView
                android:id="@+id/tvBrightness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="亮度: 0.00"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />
            <SeekBar
                android:id="@+id/seekBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50" />

            <!-- ★ 蒙版强度 -->
            <TextView
                android:id="@+id/tvOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="蒙版强度: 15%"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />
            <SeekBar
                android:id="@+id/seekOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="15" />
        </LinearLayout>

        <!-- 结果预览（PhotoView 可缩放） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="延展结果（可双指缩放）"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="320dp">

            <com.github.chrisbanes.photoview.PhotoView
                android:id="@+id/imgResult"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:background="@color/card"
                android:contentDescription="延展结果预览" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 操作按钮 -->
        <Button
            android:id="@+id/btnPick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择壁纸图片"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="下载 / 保存到相册"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:backgroundTint="@color/secondary" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="分享"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/secondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
