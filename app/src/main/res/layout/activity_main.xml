<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="iOS 17 风格壁纸延展 · 支持下载保存到相册"
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <!-- 原图预览 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="原图"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <ImageView
            android:id="@+id/imgOriginal"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="@color/card"
            android:contentDescription="原图预览" />

        <!-- 参数调节 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card"
            android:padding="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvBlur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="模糊半径: 30"
                android:textSize="14sp"
                android:textColor="@color/text_primary" />
            <SeekBar
                android:id="@+id/seekBlur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60"
                android:progress="30" />

            <TextView
                android:id="@+id/tvExtend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="延展比例: 25%"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />
            <SeekBar
                android:id="@+id/seekExtend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="25" />

            <TextView
                android:id="@+id/tvFeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="羽化宽度: 80"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />
            <SeekBar
                android:id="@+id/seekFeather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="80" />

        </LinearLayout>

        <!-- 结果预览 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="延展结果"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp">

            <ImageView
                android:id="@+id/imgResult"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/card"
                android:contentDescription="延展结果预览" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>

        <!-- 操作按钮 -->
        <Button
            android:id="@+id/btnPick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="选择壁纸图片"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="下载 / 保存到相册"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:backgroundTint="@color/secondary" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="分享"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/secondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>

</ScrollView>
